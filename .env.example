# Plantilla de variables de entorno para Cactea.
# Copia este archivo como backend/.env y completa los valores reales.
# Nunca subas backend/.env al repositorio.

PORT=3000

# Cadena de conexión de MongoDB Atlas
MONGODB_URI=mongodb+srv://usuario:clave@cluster.mongodb.net/cactea

# Usuario del panel de administración
ADMIN_USER=admin

# Hash bcrypt de la contraseña del administrador (no la contraseña en texto plano)
# Generar con:
#   cd backend
#   node -e "console.log(require('bcryptjs').hashSync('tu-clave', 10))"
ADMIN_PASS_HASH=$2b$10$reemplaza-esto-por-tu-hash

# Clave secreta para firmar los tokens JWT (larga y aleatoria)
JWT_SECRET=reemplaza-esto-por-una-clave-larga-y-aleatoria
