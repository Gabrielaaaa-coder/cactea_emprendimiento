# Plantilla de variables de entorno de Cactea.
# Copia estos nombres al panel de tu hosting (o a backend/.env en local).
# Nunca subas un .env con valores reales.

# Puerto en el que escucha Express
PORT=3000

# Cadena de conexión de MongoDB Atlas.
# MONGODB_URI es el nombre usado por el proyecto; MONGO_URI se acepta como alias.
MONGODB_URI=mongodb+srv://USUARIO:CLAVE@cluster.mongodb.net/cactea?retryWrites=true&w=majority
MONGO_URI=

# Credenciales del panel de administración
ADMIN_USER=admin
ADMIN_PASS_HASH=TU_HASH_BCRYPT_DE_LA_CONTRASENA

# Firma de los tokens de sesión
JWT_SECRET=CAMBIA_ESTE_SECRETO_POR_UNO_LARGO_Y_ALEATORIO

# Asistente con IA (clave privada: solo en el backend)
IA_API_KEY=TU_CLAVE_DE_GEMINI
IA_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
IA_MODELO=gemini-2.5-flash

# Opcional: orígenes permitidos por CORS, separados por comas.
# Si se deja vacío, Express responde a cualquier origen (útil desde un mismo servicio).
CORS_ORIGIN=
